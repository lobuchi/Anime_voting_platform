<div class="max-w-2xl mx-auto border border-gray-200 p-8">
  <h1 class="text-3xl font-bold mb-8 text-center">Edit Profile</h1>

  <%= form_with(model: @user, url: profile_path, method: :patch, class: "space-y-6") do |f| %>
    <% if @user.errors.any? %>
      <div class="p-4 border border-red-500 text-red-700 bg-red-50 mb-6 font-mono text-sm">
        <strong><%= pluralize(@user.errors.count, "error") %> prohibited this from being saved:</strong>
        <ul class="list-disc ml-5 mt-2">
          <% @user.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="flex items-center gap-6">
      <div class="w-24 h-24 shrink-0 border border-gray-200 overflow-hidden flex items-center justify-center bg-gray-100">
        <% if @user.avatar_data.present? %>
          <%= image_tag @user.avatar_data, class: "w-full h-full object-cover" %>
        <% else %>
          <span class="text-3xl font-bold text-gray-400"><%= @user.initial %></span>
        <% end %>
      </div>
      <div class="flex-grow">
        <%= f.label :avatar_file, "Avatar (Max 500KB)", class: "block font-bold mb-2" %>
        <%= f.file_field :avatar_file, accept: "image/*", class: "w-full border border-gray-300 p-3 focus:outline-none focus:border-black" %>
      </div>
    </div>

    <div>
      <%= f.label :username, "Username", class: "block font-bold mb-2" %>
      <%= f.text_field :username, class: "w-full border border-gray-300 p-3 focus:outline-none focus:border-black" %>
      <p class="text-xs text-gray-500 mt-1">Letters, numbers, and underscores only. 3–20 characters.</p>
    </div>

    <div>
      <%= f.label :display_name, "Display Name", class: "block font-bold mb-2" %>
      <%= f.text_field :display_name, class: "w-full border border-gray-300 p-3 focus:outline-none focus:border-black" %>
    </div>

    <div>
      <%= f.label :bio, "Bio", class: "block font-bold mb-2" %>
      <%= f.text_area :bio, rows: 4, class: "w-full border border-gray-300 p-3 focus:outline-none focus:border-black", placeholder: "Tell us about yourself... (max 500 characters)" %>
    </div>

    <div class="pt-4 flex justify-between items-center">
      <%= link_to "Cancel", user_profile_path(@user.username), class: "hover:underline text-gray-500" %>
      <%= f.submit "Save Profile", class: "border border-black px-8 py-3 font-bold cursor-pointer hover:bg-black hover:text-white transition-colors" %>
    </div>
  <% end %>
</div>
