<% if object.errors.any? %>
  <div class="p-4 border border-red-500 text-red-700 bg-red-50 mb-6 font-mono text-sm">
    <strong><%= pluralize(object.errors.count, "error") %> prohibited this from being saved:</strong>
    <ul class="list-disc ml-5 mt-2">
      <% object.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>
