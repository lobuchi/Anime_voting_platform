<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8 text-center border-b pb-4">Top Anime</h1>
  <div class="flex flex-col space-y-6">
    <% @animes.each_with_index do |anime, index| %>
      <%= link_to anime, class: "group block border border-gray-200 p-4 hover:border-black transition-colors" do %>
        <div class="flex items-center space-x-6">
          <div class="text-3xl font-bold text-gray-300 w-12 text-center">
            #<%= index + 1 %>
          </div>
          <div class="w-24 h-32 shrink-0 border border-gray-100 overflow-hidden">
            <% if anime.image_data.present? %>
              <%= image_tag anime.image_data, class: "w-full h-full object-cover" %>
            <% else %>
              <div class="bg-gray-100 w-full h-full flex items-center justify-center text-xs text-gray-400">No Image</div>
            <% end %>
          </div>
          <div class="flex-grow">
            <h2 class="text-xl font-bold group-hover:underline"><%= anime.title %></h2>
            <div class="mt-2 text-sm text-gray-600 border border-gray-200 inline-block px-3 py-1">
              Score: <strong><%= anime.score || 0 %></strong>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>