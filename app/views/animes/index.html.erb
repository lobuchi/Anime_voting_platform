<div class="max-w-3xl mx-auto">
  <h1 class="text-3xl font-bold mb-8 text-center border-b pb-4">Top Anime</h1>

  <!-- Search Bar -->
  <%= form_with url: animes_path, method: :get, class: "mb-6" do |f| %>
    <div class="flex gap-2">
      <%= f.text_field :q,
            value: params[:q],
            placeholder: "Search anime...",
            autocomplete: "off",
            class: "flex-grow border border-gray-300 p-3 focus:outline-none focus:border-black" %>
      <%= f.submit "Search",
            class: "border border-black px-6 py-3 font-bold cursor-pointer hover:bg-black hover:text-white transition-colors" %>
      <% if params[:q].present? %>
        <%= link_to "Clear", animes_path,
              class: "border border-gray-300 px-6 py-3 font-bold hover:bg-gray-100 transition-colors" %>
      <% end %>
    </div>
  <% end %>

  <!-- Result Count -->
  <% if params[:q].present? && @animes.any? %>
    <p class="text-sm text-gray-500 mb-4">
      <%= pluralize(@animes.count, "result") %> for "<%= params[:q] %>"
    </p>
  <% end %>

  <!-- Anime List -->
  <% if @animes.any? %>
    <div class="flex flex-col space-y-6">
      <% @animes.each_with_index do |anime, index| %>
        <%= link_to anime, class: "group block border border-gray-200 p-4 hover:border-black transition-colors" do %>
          <div class="flex items-center space-x-6">
            <div class="text-3xl font-bold text-gray-300 w-12 text-center">
              #<%= index + 1 %>
            </div>
            <div class="w-24 h-32 shrink-0 border border-gray-100 overflow-hidden">
              <% if anime.image_data.present? %>
                <%= image_tag anime.image_data, class: "w-full h-full object-cover" %>
              <% else %>
                <div class="bg-gray-100 w-full h-full flex items-center justify-center text-xs text-gray-400">No Image</div>
              <% end %>
            </div>
            <div class="flex-grow">
              <h2 class="text-xl font-bold group-hover:underline"><%= anime.title %></h2>
              <div class="mt-2 text-sm text-gray-600 border border-gray-200 inline-block px-3 py-1">
                Score: <strong><%= anime.score || 0 %></strong>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <p class="text-center text-gray-500 py-12">
      <% if params[:q].present? %>
        No anime found matching "<%= params[:q] %>".
      <% else %>
        No anime yet.
      <% end %>
    </p>
  <% end %>
</div>