<div style="max-width: 64rem; margin-left: auto; margin-right: auto; display: flex; flex-direction: row; gap: 2.5rem;">
  <!-- Left Side: Image and Basic Info -->
  <div style="width: 33.333333%; display: flex; flex-direction: column; gap: 1rem;">
    <% if @anime.image_data.present? %>
      <%= image_tag @anime.image_data, style: "width: 100%; border: 1px solid #e5e7eb;" %>
    <% else %>
      <div style="background-color: #f3f4f6; aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; border: 1px solid #e5e7eb; color: #6b7280;">No Image</div>
    <% end %>

    <div style="padding-top: 1rem; border-top: 1px solid #e5e7eb;">
      <h3 style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin-bottom: 0.5rem; margin-top: 0;">Current Score</h3>
      <div style="font-size: 1.5rem; font-weight: 700; color: #111827;"><%= @anime.score || 0 %></div>
    </div>

    <!-- Consistent Voting Section for logged in users -->
    <div style="padding-top: 1rem; border-top: 1px solid #e5e7eb;">
      <% if Current.user %>
        <div style="display: flex; gap: 0.75rem; width: 100%;">

          <% if @vote&.value&.positive? %>
            <!-- Active Upvote (Click to remove) -->
            <%= button_to "▲ Voted +1", anime_vote_path(@anime, @vote),
                  method: :delete,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #16a34a; color: #fff; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <!-- Inactive Downvote -->
            <%= button_to "▼ -1", anime_votes_path(@anime, score: -1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #fef2f2; color: #b91c1c; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>

          <% elsif @vote&.value&.negative? %>
            <!-- Inactive Upvote -->
            <%= button_to "▲ +1", anime_votes_path(@anime, score: 1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #f0fdf4; color: #15803d; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <!-- Active Downvote (Click to remove) -->
            <%= button_to "▼ Voted -1", anime_vote_path(@anime, @vote),
                  method: :delete,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #dc2626; color: #fff; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>

          <% else %>
            <!-- No Vote Yet -->
            <%= button_to "▲ +1", anime_votes_path(@anime, score: 1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #f0fdf4; color: #15803d; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <%= button_to "▼ -1", anime_votes_path(@anime, score: -1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #fef2f2; color: #b91c1c; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
          <% end %>

        </div>
      <% else %>
        <p style="font-size: 0.875rem; color: #6b7280; margin: 0;"><%= link_to "Login to vote", new_session_path, style: "text-decoration: underline; color: inherit;" %></p>
      <% end %>
    </div>

    <!-- Delete option for Admin -->
    <% if Current.user&.admin? %>
      <div style="padding-top: 2rem; text-align: center; border-top: 1px solid #e5e7eb; font-size: 0.875rem;">
        <%= button_to "Delete Anime (Admin)", anime_path(@anime),
              method: :delete,
              data: { turbo_confirm: "Are you sure?" },
              style: "background: none; border: none; color: #dc2626; text-decoration: underline; cursor: pointer; padding: 0;" %>
      </div>
    <% end %>
  </div>

  <!-- Right Side: Details, Trailer, Comments -->
  <div style="width: 66.666667%; display: flex; flex-direction: column; gap: 2.5rem;">
    <div style="display: flex; flex-direction: column; gap: 1rem;">
      <h1 style="font-size: 2.25rem; font-weight: 900; letter-spacing: -0.025em; margin: 0;"><%= @anime.title %></h1>

      <!-- Description Section -->
      <% if @anime.description.present? %>
        <p style="color: #4b5563; font-size: 1rem; line-height: 1.6; margin: 0; white-space: pre-line;"><%= @anime.description %></p>
      <% end %>
    </div>

    <!-- Trailer -->
    <% if @anime.trailer_url.present? %>
      <div style="border: 1px solid #e5e7eb; padding: 0.25rem;">
        <div style="aspect-ratio: 16 / 9; width: 100%;">
          <iframe
            src="<%= @anime.trailer_url.gsub("watch?v=", "embed/") %>"
            title="YouTube video player"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            style="width: 100%; height: 100%; border: none;">
          </iframe>
        </div>
      </div>
    <% end %>

    <!-- Comments -->
    <div style="border-top: 1px solid #e5e7eb; padding-top: 2rem;">
      <h2 style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; margin-top: 0;">Comments</h2>

      <% if Current.user %>
        <%= form_with(model: [@anime, Comment.new], html: { style: "margin-bottom: 2rem; display: flex; flex-direction: column; align-items: flex-end;" }) do |f| %>
          <%= f.text_area :content, rows: 3, style: "width: 100%; border: 1px solid #d1d5db; padding: 0.75rem; margin-bottom: 0.5rem; box-sizing: border-box;", placeholder: "Share your thoughts..." %>
          <%= f.submit "Post Comment", style: "border: 1px solid #000; background: #fff; color: #000; padding: 0.5rem 1.5rem; cursor: pointer;" %>
        <% end %>
      <% else %>
        <p style="margin-bottom: 2rem; color: #6b7280;"><%= link_to "Login", new_session_path, style: "text-decoration: underline; color: inherit;" %> to add a comment.</p>
      <% end %>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <% @comments.each do |comment| %>
          <div style="border-bottom: 1px solid #f3f4f6; padding-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.25rem;">
              <span style="font-weight: 700; font-size: 0.875rem;"><%= comment.user.email_address.split('@').first %></span>
              <span style="font-size: 0.75rem; color: #9ca3af;"><%= time_ago_in_words(comment.created_at) %> ago</span>
            </div>
            <p style="color: #1f2937; margin: 0;"><%= comment.content %></p>
            <% if Current.user == comment.user || Current.user&.admin? %>
              <div style="margin-top: 0.5rem; text-align: right;">
                <%= button_to "Delete", anime_comment_path(@anime, comment),
                      method: :delete,
                      data: { turbo_confirm: "Delete comment?" },
                      style: "background: none; border: none; font-size: 0.75rem; color: #ef4444; text-decoration: underline; cursor: pointer; padding: 0;" %>
              </div>
            <% end %>
          </div>
        <% end %>
        <% if @comments.empty? %>
          <p style="color: #9ca3af; font-size: 0.875rem; margin: 0;">No comments yet.</p>
        <% end %>
      </div>
    </div>
  </div>
</div>