        </span>

        <!-- NEW: Share Button -->
        <button onclick="copyLink(this)" style="background: none; border: 1px solid #d1d5db; padding: 0.25rem 0.6rem; border-radius: 4px; font-size: 0.75rem; font-weight: bold; cursor: pointer; color: #6b7280; display: flex; align-items: center; gap: 4px; transition: background 0.2s;" class="hover:bg-gray-100 dark:hover:bg-gray-700">
          🔗 Share
        </button>
