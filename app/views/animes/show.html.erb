<% content_for :title, "#{@anime.title} — Anime Tracker" %>


<div style="max-width: 64rem; margin-left: auto; margin-right: auto; display: flex; flex-direction: row; gap: 2.5rem;">
  <!-- Left Side: Image and Basic Info -->
  <div style="width: 33.333333%; display: flex; flex-direction: column; gap: 1rem;">
    <% if @anime.image_data.present? %>
      <%= image_tag @anime.image_data, style: "width: 100%; border: 1px solid #e5e7eb;" %>
    <% else %>
      <div style="background-color: #f3f4f6; aspect-ratio: 3 / 4; display: flex; align-items: center; justify-content: center; border: 1px solid #e5e7eb; color: #6b7280;">No Image</div>
    <% end %>

    <div style="padding-top: 1rem; border-top: 1px solid #e5e7eb;">
      <h3 style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin-bottom: 0.5rem; margin-top: 0;">Current Score</h3>
      <div style="font-size: 1.5rem; font-weight: 700; color: #111827;"><%= @anime.score || 0 %></div>
     <p style="font-size: 0.75rem; color: #9ca3af; margin: 0.25rem 0 0 0;">
    from <%= pluralize(@anime.votes.count, "users") %>
  </p>
    </div>

    <!-- Watch Status -->
    <% if Current.user %>
      <div style="padding-top: 1rem; border-top: 1px solid #e5e7eb;">
        <h3 style="font-size: 0.875rem; text-transform: uppercase; letter-spacing: 0.05em; color: #6b7280; margin-bottom: 0.5rem; margin-top: 0;">Your Status</h3>

        <% if @watch_status %>
          <div style="margin-bottom: 0.5rem;">
            <span class="<%= @watch_status.color_classes %>" style="display: inline-block; padding: 0.25rem 0.75rem; border: 1px solid; border-radius: 4px; font-size: 0.875rem; font-weight: 600;">
              <%= @watch_status.label %>
            </span>
          </div>
        <% end %>

        <div style="display: flex; flex-wrap: wrap; gap: 0.25rem;">
          <% WatchStatus.statuses.keys.each do |s| %>
            <% active = @watch_status&.status == s %>
            <%= button_to (active ? "✓ " : "") + s.titleize,
                  anime_watch_status_path(@anime, status: s),
                  method: active ? :delete : (@watch_status ? :patch : :post),
                  form: { style: "margin: 0;" },
                  style: "padding: 0.25rem 0.6rem; font-size: 0.75rem; border-radius: 4px; cursor: pointer; border: 1px solid #d1d5db; #{active ? 'background:#111827;color:#fff;' : 'background:#fff;color:#374151;'}" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <!-- Voting Section -->
    <div style="padding-top: 1rem; border-top: 1px solid #e5e7eb;">
      <% if Current.user %>
        <div style="display: flex; gap: 0.75rem; width: 100%;">

          <% if @vote&.value&.positive? %>
            <%= button_to "▲ Voted +1", anime_vote_path(@anime, @vote),
                  method: :delete,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #16a34a; color: #fff; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <%= button_to "▼ -1", anime_votes_path(@anime, score: -1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #fef2f2; color: #b91c1c; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>

          <% elsif @vote&.value&.negative? %>
            <%= button_to "▲ +1", anime_votes_path(@anime, score: 1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #f0fdf4; color: #15803d; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <%= button_to "▼ Voted -1", anime_vote_path(@anime, @vote),
                  method: :delete,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #dc2626; color: #fff; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>

          <% else %>
            <%= button_to "▲ +1", anime_votes_path(@anime, score: 1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #16a34a; background: #f0fdf4; color: #15803d; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
            <%= button_to "▼ -1", anime_votes_path(@anime, score: -1),
                  method: :post,
                  form: { style: "flex: 1 1 0%; margin: 0;" },
                  style: "width: 100%; box-sizing: border-box; border: 1px solid #dc2626; background: #fef2f2; color: #b91c1c; font-weight: 600; padding: 0.5rem; cursor: pointer; border-radius: 4px; font-size: 0.875rem;" %>
          <% end %>

        </div>
      <% else %>
        <p style="font-size: 0.875rem; color: #6b7280; margin: 0;"><%= link_to "Login to vote", new_session_path, style: "text-decoration: underline; color: inherit;" %></p>
      <% end %>
    </div>

<!-- Admin actions -->
<% if Current.user&.admin? %>
<div style="padding-top: 2rem; border-top: 1px solid #e5e7eb; display: flex; justify-content: center; gap: 1.5rem; font-size: 0.875rem;">
  <%= link_to "Edit Anime", edit_anime_path(@anime),
        style: "color: #2563eb; text-decoration: underline;" %>

  <%= button_to "Delete Anime",
        anime_path(@anime),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
